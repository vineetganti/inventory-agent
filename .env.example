# Copy this file to .env and fill in your values.

# Which model answers (see llm.py):
#   groq   -> openai/gpt-oss-120b on Groq, needs GROQ_API_KEY            (default)
#   claude -> Claude Haiku 5.5 through Claude Code (claude -p), signed in with a Claude subscription
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-key
# LLM_MODEL=openai/gpt-oss-20b   # optional: another model id for the chosen provider

# Needed by v5-v7 (email alerts). For Gmail, create an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=manager@example.com

# Needed by v6-v7 (tracing). Free account at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=inventory-agent
# LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com   # only if your organisation is in another region
